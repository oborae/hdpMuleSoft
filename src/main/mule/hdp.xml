	<dynamics365ForOperations:dynamics-365-for-operations-config name="Dynamics_365_For_Operations_Dynamics_365_for_operations" doc:name="Dynamics 365 For Operations Dynamics 365 for operations" doc:id="6e109d7f-f365-4332-8f05-78e1af9fe10e" >
		<dynamics365ForOperations:oauth-client-credentials-connection resource="https://hdric-uat.sandbox.operations.dynamics.com" >
			<dynamics365ForOperations:oauth-client-credentials clientId="C0418691-175b-4fce-9cbc-d3661ded3df4" clientSecret="G4l8Q~eSpCQvMRm.xldFTNs2UMfoOjZxsgCB2dmG" tokenUrl="https://login.microsoftonline.com/545510a6-3f86-4b4c-ab29-46e704381a76/oauth2/v2.0/token" scopes="https://hdric-uat.sandbox.operations.dynamics.com/.default"/>
